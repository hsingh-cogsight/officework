# --- Azure AD app registration (Teams / Graph) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Public client (device code flow) - no client secret needed for delegated auth

# --- What to watch ---
# Team + channel to always notify on (find via Graph /teams and /teams/{id}/channels)
TEAMS_WATCH_TEAM_ID=
TEAMS_WATCH_CHANNEL_ID=
# Your own Graph user id, used to detect @mentions anywhere (find via /me)
GRAPH_MY_USER_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Poll tuning ---
POLL_INTERVAL_SECONDS=30
